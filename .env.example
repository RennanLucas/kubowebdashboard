VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PAYMENTS_CLIENT_TOKEN=
# Production defaults to live. Set this to sandbox only in the protected test preview.
VITE_PAYMENTS_ENVIRONMENT=live

# Feature Flags (set to 'true' to enable)
VITE_ENABLE_3D_LANDING=false

# Edge Function secrets are configured in Supabase, never exposed as VITE_*.
# Keep sandbox and live credentials in different projects/deployments.
# PAYMENTS_ENVIRONMENT=sandbox|live
# MP_SANDBOX_ACCESS_TOKEN=
# MP_SANDBOX_WEBHOOK_SECRET=
# MERCADO_PAGO_ACCESS_TOKEN=
# MP_WEBHOOK_SECRET=
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=
# GEMINI_API_KEY=
# APP_URL=https://your-preview.example
# PUBLIC_APP_URL=https://your-preview.example
