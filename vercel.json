{
  "headers": [
    {
      "source": "/kubo-bridge/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/api/edge/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "CDN-Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://*.supabase.co https://ipapi.co wss://*.supabase.co; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; frame-ancestors 'none';"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kubo-bridge/access",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/token?grant_type=password"
    },
    {
      "source": "/kubo-bridge/renew",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/token?grant_type=refresh_token"
    },
    {
      "source": "/kubo-bridge/complete",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/token?grant_type=pkce"
    },
    {
      "source": "/kubo-bridge/federate",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/token?grant_type=id_token"
    },
    {
      "source": "/kubo-bridge/exchange",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/token"
    },
    {
      "source": "/kubo-bridge/create",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/signup"
    },
    {
      "source": "/kubo-bridge/message",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/otp"
    },
    {
      "source": "/kubo-bridge/confirm",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/verify"
    },
    {
      "source": "/kubo-bridge/assist",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/recover"
    },
    {
      "source": "/kubo-bridge/profile",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/user"
    },
    {
      "source": "/kubo-bridge/exit",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/logout"
    },
    {
      "source": "/kubo-bridge/repeat",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/resend"
    },
    {
      "source": "/kubo-bridge/config",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/auth/v1/settings"
    },
    {
      "source": "/api/edge/:path*",
      "destination": "https://gitzmynfamubetgujtmm.supabase.co/functions/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
